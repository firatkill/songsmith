# Environment variable names will be added by the tasks that introduce them.
# Disabled local OAuth providers; configure when enabling them in a later task.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Backend environment: local (default), ci, production.
APP_ENV=
# mock by default; live providers remain prohibited before M6.
PROVIDER_MODE=
# Explicit production demo override; false by default.
ALLOW_MOCK_IN_PRODUCTION=
# Explicit local/CI live override; false by default.
ALLOW_LIVE_PROVIDERS=
# Local Supabase API URL and anon key (supabase status).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend-only secret; never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# JWT issuer; defaults to ${SUPABASE_URL}/auth/v1 when absent.
SUPABASE_JWT_ISSUER=
# API port, default 4000.
API_PORT=
# Comma-separated origins, default http://localhost:3000.
WEB_ORIGINS=
# Reverse proxy hops, default 0 locally.
TRUST_PROXY_HOPS=
# JSON log level, default info.
LOG_LEVEL=
