{
  "name": "@songsmith/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "next typegen && eslint src e2e playwright.config.ts next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config ../vitest.config.mjs --project @songsmith/frontend --passWithNoTests",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@songsmith/api-client": "workspace:*",
    "@songsmith/i18n": "workspace:*",
    "@songsmith/schemas": "workspace:*",
    "@songsmith/ui-tokens": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@next/eslint-plugin-next": "16.4.6"
  }
}
