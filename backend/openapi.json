                        "bio": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "display_name": {
                          "type": "string"
                        },
                        "explicit_hidden": {
                          "type": "boolean"
                        },
                        "handle": {
                          "type": "string"
                        },
                        "id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "is_adult": {
                          "type": "boolean"
                        },
                        "locale": {
                          "enum": ["tr", "en"],
