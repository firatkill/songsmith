{
  "components": {
    "parameters": {},
    "schemas": {
      "ErrorResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "CONSENT_REQUIRED",
                  "NOT_ADULT",
                  "VALIDATION",
                  "PAYLOAD_TOO_LARGE",
                  "MODERATION_BLOCKED",
                  "MODERATION_HARD_BLOCKED",
                  "INSUFFICIENT_CREDITS",
                  "MODEL_NOT_ELIGIBLE",
                  "RATE_LIMITED",
                  "CONCURRENCY_LIMIT",
                  "CAP_REACHED",
                  "KILL_SWITCH",
                  "PROVIDER_TIMEOUT",
                  "NOT_FOUND",
                  "CONFLICT",
                  "INTERNAL"
                ],
                "type": "string"
              },
              "details": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/ErrorResponse___schema0"
                },
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ErrorResponse___schema0": {}
    }
  },
  "info": {
    "title": "Songsmith API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/catalogue": {
      "get": {
        "description": "All catalogue rows with prices, languages and current usability.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "models": {
                      "items": {
                        "properties": {
                          "adapter": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "id": {
                            "type": "string"
                          },
                          "isMock": {
                            "type": "boolean"
                          },
                          "kind": {
                            "enum": ["music", "text", "image", "alignment"],
                            "type": "string"
                          },
                          "languages": {
                            "items": {
                              "properties": {
                                "language": {
                                  "type": "string"
                                },
                                "status": {
                                  "enum": ["unverified", "beta", "verified"],
                                  "type": "string"
                                }
                              },
                              "required": ["language", "status"],
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "prices": {
                            "items": {
                              "properties": {
                                "credits": {
                                  "type": "integer"
                                },
                                "estCostMicroUsd": {
                                  "type": "integer"
                                },
                                "operation": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operation",
                                "credits",
                                "estCostMicroUsd"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "qualityRank": {
                            "type": "integer"
                          },
                          "usable": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "adapter",
                          "displayName",
                          "enabled",
                          "qualityRank",
                          "isMock",
                          "usable",
                          "prices",
                          "languages"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": ["models"],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      }
    },
    "/v1/admin/catalogue/{id}": {
      "patch": {
        "description": "Enable or disable a model or change its quality rank. Audited; applies within 60 s.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "qualityRank": {
                    "maximum": 1000,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "adapter": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "isMock": {
                      "type": "boolean"
                    },
                    "kind": {
                      "enum": ["music", "text", "image", "alignment"],
                      "type": "string"
                    },
                    "languages": {
                      "items": {
                        "properties": {
                          "language": {
                            "type": "string"
                          },
                          "status": {
                            "enum": ["unverified", "beta", "verified"],
                            "type": "string"
                          }
                        },
                        "required": ["language", "status"],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "prices": {
                      "items": {
                        "properties": {
                          "credits": {
                            "type": "integer"
                          },
                          "estCostMicroUsd": {
                            "type": "integer"
                          },
                          "operation": {
                            "type": "string"
                          }
                        },
                        "required": ["operation", "credits", "estCostMicroUsd"],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "qualityRank": {
                      "type": "integer"
                    },
                    "usable": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "adapter",
                    "displayName",
                    "enabled",
                    "qualityRank",
                    "isMock",
                    "usable",
                    "prices",
                    "languages"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      }
    },
    "/v1/admin/flags": {
      "get": {
        "description": "Every registered flag with its current and default value.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "flags": {
                      "items": {
                        "properties": {
                          "defaultValue": {},
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          },
                          "key": {
                            "type": "string"
                          },
                          "placeholder": {
                            "type": "boolean"
                          },
                          "public": {
                            "type": "boolean"
                          },
                          "type": {
                            "enum": ["boolean", "number", "json"],
                            "type": "string"
                          },
                          "value": {}
                        },
                        "required": [
                          "key",
                          "description",
                          "public",
                          "placeholder",
                          "type",
                          "isDefault"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": ["flags"],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      }
    },
    "/v1/admin/flags/{key}": {
      "put": {
        "description": "Set a flag value. Validated against the flag registry; audited; applies within 60 s.",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "value": {}
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "defaultValue": {},
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "key": {
                      "type": "string"
                    },
                    "placeholder": {
                      "type": "boolean"
                    },
                    "public": {
                      "type": "boolean"
                    },
                    "type": {
                      "enum": ["boolean", "number", "json"],
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "key",
                    "description",
                    "public",
                    "placeholder",
                    "type",
                    "isDefault"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      }
    },
    "/v1/admin/whoami": {
      "get": {
        "description": "Staff identity for the admin console (staff and AAL2 only).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "roles": {
                      "items": {
                        "enum": ["moderator", "admin"],
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "userId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": ["userId", "roles"],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      }
    },
    "/v1/catalogue": {
      "get": {
        "description": "Enabled music models with capabilities, credit prices, language statuses and current availability.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "models": {
                      "items": {
                        "properties": {
                          "available": {
                            "type": "boolean"
                          },
                          "capabilities": {
                            "additionalProperties": false,
                            "properties": {
                              "acceptsExternalAudio": {
                                "type": "boolean"
                              },
                              "controls": {
                                "additionalProperties": false,
                                "properties": {
                                  "bpm": {
                                    "type": "boolean"
                                  },
                                  "lengthControl": {
                                    "type": "boolean"
                                  },
                                  "vocalType": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "bpm",
                                  "lengthControl",
                                  "vocalType"
                                ],
                                "type": "object"
                              },
                              "maxDurationSec": {
                                "exclusiveMinimum": 0,
                                "type": "integer"
                              },
                              "minDurationSec": {
                                "exclusiveMinimum": 0,
                                "type": "integer"
                              },
                              "operations": {
                                "items": {
                                  "enum": [
                                    "generate",
                                    "instrumental",
                                    "custom_lyrics",
                                    "extend",
                                    "stems",
                                    "image_input"
                                  ],
                                  "type": "string"
                                },
                                "minItems": 1,
                                "type": "array"
                              },
                              "outputFormats": {
                                "items": {
                                  "enum": ["mp3", "wav"],
                                  "type": "string"
                                },
                                "minItems": 1,
                                "type": "array"
                              },
                              "returnsLyrics": {
                                "type": "boolean"
                              },
                              "returnsTimestamps": {
                                "enum": ["none", "line", "word"],
                                "type": "string"
                              },
                              "stemSets": {
                                "items": {
                                  "type": "string"
                                },
                                "type": "array"
                              },
                              "watermark": {
                                "items": {
                                  "enum": ["synthid", "c2pa", "none"],
                                  "type": "string"
                                },
                                "type": "array"
                              }
                            },
                            "required": [
                              "operations",
                              "maxDurationSec",
                              "minDurationSec",
                              "outputFormats",
                              "controls",
                              "returnsTimestamps",
                              "returnsLyrics",
                              "acceptsExternalAudio",
                              "stemSets",
                              "watermark"
                            ],
                            "type": "object"
                          },
                          "displayName": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "id": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "languages": {
                            "additionalProperties": {
                              "enum": ["unverified", "beta", "verified"],
                              "type": "string"
                            },
                            "type": "object"
                          },
                          "prices": {
                            "properties": {
                              "custom_lyrics": {
                                "minimum": 0,
                                "type": "integer"
                              },
                              "extend": {
                                "minimum": 0,
                                "type": "integer"
                              },
                              "generate": {
                                "minimum": 0,
                                "type": "integer"
                              },
                              "image_input": {
                                "minimum": 0,
                                "type": "integer"
                              },
                              "instrumental": {
                                "minimum": 0,
                                "type": "integer"
                              },
                              "stems": {
                                "minimum": 0,
                                "type": "integer"
                              }
                            },
                            "type": "object"
                          },
                          "qualityRank": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "id",
                          "displayName",
                          "qualityRank",
                          "capabilities",
                          "prices",
                          "languages",
                          "available"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": ["models"],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": ["public, max-age=30"],
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "public"
      }
    },
    "/v1/flags/public": {
      "get": {
        "description": "Public kill-switch states only. Cached for 30 seconds.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "kill_switch:all": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:align": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:cover": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:custom_lyrics": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:extend": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:generate": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:image_input": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:instrumental": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:lyrics": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:remix": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:rewrite": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:stems": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:video": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-align": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-image": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-image-safety": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-music-a": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-music-b": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-text": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kill_switch:all",
                    "kill_switch:provider:mock-music-a",
                    "kill_switch:provider:mock-music-b",
                    "kill_switch:provider:mock-text",
                    "kill_switch:provider:mock-image",
                    "kill_switch:provider:mock-image-safety",
                    "kill_switch:provider:mock-align",
                    "kill_switch:operation:generate",
                    "kill_switch:operation:instrumental",
                    "kill_switch:operation:custom_lyrics",
                    "kill_switch:operation:image_input",
                    "kill_switch:operation:lyrics",
                    "kill_switch:operation:rewrite",
                    "kill_switch:operation:extend",
                    "kill_switch:operation:remix",
                    "kill_switch:operation:stems",
                    "kill_switch:operation:cover",
                    "kill_switch:operation:align",
                    "kill_switch:operation:video"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": ["public, max-age=30"],
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "public"
      }
    },
    "/v1/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "env": {
                      "enum": ["local", "ci", "production"],
                      "type": "string"
                    },
                    "providerMode": {
                      "enum": ["mock", "live"],
                      "type": "string"
                    },
                    "status": {
                      "enum": ["ok"],
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "version", "env", "providerMode"],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "public"
      }
    },
    "/v1/me": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "consents": {
                      "items": {
                        "properties": {
                          "at": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string"
                          },
                          "granted": {
                            "type": "boolean"
                          },
                          "id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "isCurrent": {
                            "type": "boolean"
                          },
                          "kind": {
                            "enum": [
                              "terms",
                              "privacy",
                              "ai_disclosure",
                              "marketing",
                              "analytics"
                            ],
                            "type": "string"
                          },
                          "source": {
                            "enum": ["web", "ios", "android"],
                            "type": "string"
                          },
                          "user_id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "user_id",
                          "kind",
                          "version",
                          "granted",
                          "source",
                          "at",
                          "created_at",
                          "isCurrent"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "missingConsents": {
                      "items": {
                        "enum": [
                          "terms",
                          "privacy",
                          "ai_disclosure",
                          "marketing",
                          "analytics"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "needsAgeGate": {
                      "type": "boolean"
                    },
                    "profile": {
                      "properties": {
                        "adult_verified_at": {
                          "type": ["string", "null"]
                        },
                        "avatar_seed": {
                          "type": "string"
                        },
                        "bio": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "display_name": {
                          "type": "string"
                        },
                        "explicit_hidden": {
                          "type": "boolean"
                        },
                        "handle": {
                          "type": "string"
                        },
                        "id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "is_adult": {
                          "type": "boolean"
                        },
                        "locale": {
                          "enum": ["tr", "en"],
                          "type": "string"
                        },
                        "remix_default": {
                          "type": "boolean"
                        },
                        "status": {
                          "enum": [
                            "active",
                            "cooldown",
                            "suspended",
                            "banned",
                            "deleted"
                          ],
                          "type": "string"
                        },
                        "updated_at": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "handle",
                        "display_name",
                        "bio",
                        "avatar_seed",
                        "locale",
                        "is_adult",
                        "adult_verified_at",
                        "remix_default",
                        "explicit_hidden",
                        "status",
                        "created_at",
                        "updated_at"
                      ],
                      "type": "object"
                    },
                    "settings": {
                      "properties": {
                        "analytics_consent": {
                          "type": "boolean"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "marketing_email_opt_in": {
                          "type": "boolean"
                        },
                        "notification_prefs": {
                          "additionalProperties": {},
                          "type": "object"
                        },
                        "updated_at": {
                          "type": "string"
                        },
                        "user_id": {
