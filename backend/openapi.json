                          },
                          "user_id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "user_id",
                          "kind",
                          "version",
                          "granted",
                          "source",
                          "at",
                          "created_at",
                          "isCurrent"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "missingConsents": {
                      "items": {
                        "enum": [
                          "terms",
                          "privacy",
                          "ai_disclosure",
                          "marketing",
                          "analytics"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "needsAgeGate": {
                      "type": "boolean"
