                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      },
      "patch": {
        "description": "Updates handle, locale, remix_default and explicit_hidden only. display_name and bio edits wait for the profile moderation pipeline (T-15).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "explicit_hidden": {
                    "type": "boolean"
                  },
                  "handle": {
                    "pattern": "^[a-z0-9_]{3,30}$",
                    "type": "string"
                  },
                  "locale": {
                    "enum": ["tr", "en"],
                    "type": "string"
                  },
                  "remix_default": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "adult_verified_at": {
                      "type": ["string", "null"]
                    },
                    "avatar_seed": {
                      "type": "string"
                    },
                    "bio": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    },
                    "explicit_hidden": {
                      "type": "boolean"
                    },
                    "handle": {
                      "type": "string"
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "is_adult": {
                      "type": "boolean"
                    },
                    "locale": {
                      "enum": ["tr", "en"],
                      "type": "string"
                    },
                    "remix_default": {
                      "type": "boolean"
                    },
                    "status": {
                      "enum": [
                        "active",
                        "cooldown",
                        "suspended",
                        "banned",
                        "deleted"
                      ],
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "handle",
                    "display_name",
                    "bio",
                    "avatar_seed",
                    "locale",
                    "is_adult",
                    "adult_verified_at",
                    "remix_default",
                    "explicit_hidden",
                    "status",
                    "created_at",
                    "updated_at"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the fixed window resets",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "required"
      }
