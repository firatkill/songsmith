                        "explicit_hidden",
                        "status",
                        "created_at",
                        "updated_at"
                      ],
                      "type": "object"
                    },
                    "settings": {
                      "properties": {
                        "analytics_consent": {
                          "type": "boolean"
                        },
                        "created_at": {
