  "paths": {
    "/v1/flags/public": {
      "get": {
        "description": "Public kill-switch states only. Cached for 30 seconds.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "kill_switch:all": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:align": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:cover": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:custom_lyrics": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:extend": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:generate": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:image_input": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:instrumental": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:lyrics": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:remix": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:rewrite": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:stems": {
                      "type": "boolean"
                    },
                    "kill_switch:operation:video": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-align": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-image": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-image-safety": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-music-a": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-music-b": {
                      "type": "boolean"
                    },
                    "kill_switch:provider:mock-text": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kill_switch:all",
                    "kill_switch:provider:mock-music-a",
                    "kill_switch:provider:mock-music-b",
                    "kill_switch:provider:mock-text",
                    "kill_switch:provider:mock-image",
                    "kill_switch:provider:mock-image-safety",
                    "kill_switch:provider:mock-align",
                    "kill_switch:operation:generate",
                    "kill_switch:operation:instrumental",
                    "kill_switch:operation:custom_lyrics",
                    "kill_switch:operation:image_input",
                    "kill_switch:operation:lyrics",
                    "kill_switch:operation:rewrite",
                    "kill_switch:operation:extend",
                    "kill_switch:operation:remix",
                    "kill_switch:operation:stems",
                    "kill_switch:operation:cover",
                    "kill_switch:operation:align",
                    "kill_switch:operation:video"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": ["public, max-age=30"],
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "public"
      }
    },
    "/v1/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "env": {
                      "enum": ["local", "ci", "production"],
                      "type": "string"
                    },
                    "providerMode": {
                      "enum": ["mock", "live"],
                      "type": "string"
                    },
                    "status": {
                      "enum": ["ok"],
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "version", "env", "providerMode"],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 200"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "API error"
          }
        },
        "x-auth-mode": "public"
      }
    },
    "/v1/me": {
