                        },
                        "updated_at": {
                          "type": "string"
                        },
                        "user_id": {
                          "format": "uuid",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "user_id",
                        "notification_prefs",
                        "marketing_email_opt_in",
                        "analytics_consent",
                        "created_at",
                        "updated_at"
