{
  "name": "@songsmith/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../vitest.config.mjs --project @songsmith/backend --passWithNoTests",
    "dev": "tsx watch --env-file-if-exists=../.env.local src/server.ts",
    "start": "node --env-file-if-exists=../.env.local dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "openapi": "tsx scripts/openapi.ts",
    "test:integration": "node --env-file-if-exists=../.env.local ../node_modules/vitest/vitest.mjs run --config vitest.integration.config.mjs",
    "dev:worker": "tsx watch --env-file-if-exists=../.env.local src/worker.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@bull-board/api": "9.13.0",
    "@bull-board/express": "9.13.0",
    "@songsmith/i18n": "workspace:*",
    "@songsmith/schemas": "workspace:*",
    "@supabase/supabase-js": "2.119.0",
    "bullmq": "6.7.4",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "tsx": "4.23.15"
  }
}
