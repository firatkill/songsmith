{
  "name": "@songsmith/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eval": {
      "types": "./dist/eval.d.ts",
      "import": "./dist/eval.js",
      "default": "./dist/eval.js"
    }
  },
  "scripts": {
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../vitest.config.mjs --project @songsmith/backend --passWithNoTests",
    "dev": "tsx watch --env-file-if-exists=../.env.local src/server.ts",
    "start": "node --env-file-if-exists=../.env.local dist/server.js",
    "start:worker": "node --env-file-if-exists=../.env.local dist/worker.js",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.eval.json && mkdir -p dist/moderation/policy && cp src/moderation/policy/*.md dist/moderation/policy/ && mkdir -p dist/lyricist/prompts && cp src/lyricist/prompts/*.md dist/lyricist/prompts/",
    "openapi": "tsx scripts/openapi.ts",
    "test:integration": "node --env-file-if-exists=../.env.local ../node_modules/vitest/vitest.mjs run --config vitest.integration.config.mjs",
    "dev:worker": "tsx watch --env-file-if-exists=../.env.local src/worker.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@breezystack/lamejs": "1.2.7",
    "@bull-board/api": "9.13.0",
    "@bull-board/express": "9.13.0",
    "@songsmith/domain": "workspace:*",
    "@songsmith/i18n": "workspace:*",
    "@songsmith/moderation-rules": "workspace:*",
    "@songsmith/schemas": "workspace:*",
    "@supabase/supabase-js": "2.119.0",
    "bullmq": "6.7.4",
    "cors": "2.8.6",
    "express": "5.3.0",
    "franc-min": "6.2.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "node-id3": "0.2.9",
    "pino": "10.4.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15"
  }
}
