{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "packages/config/**",
    "eslint.config.mjs",
    "vitest.config.mjs"
  ],
  "tasks": {
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "//#lint:root": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "//#format:write": {
      "cache": false
    },
    "//#format:verify": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
