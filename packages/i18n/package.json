{
  "name": "@songsmith/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.mjs --project @songsmith/i18n --passWithNoTests",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/inline-messages.mjs"
  },
  "dependencies": {
    "intl-messageformat": "12.1.5"
  },
  "main": "./dist/index.js",
