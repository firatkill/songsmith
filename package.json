{
  "name": "songsmith",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.mjs vitest.config.mjs scripts/*.mjs packages/config/*.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:scripts",
    "format": "turbo run format:write",
    "format:write": "prettier --write .",
    "format:check": "turbo run format:verify",
    "format:verify": "prettier --check .",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:all": "node --env-file-if-exists=.env.local scripts/dev-all.mjs",
    "dev:check": "node --env-file-if-exists=.env.local scripts/dev-check.mjs",
    "dev:mobile": "node --env-file-if-exists=.env.local scripts/dev-mobile.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/db-types.mjs",
    "test:db": "supabase test db",
    "test:integration": "pnpm --filter @songsmith/backend... build && pnpm --filter @songsmith/backend test:integration",
    "e2e": "node scripts/e2e-web.mjs",
    "e2e:mobile": "node scripts/e2e-mobile.mjs",
    "moderation:hash": "node --experimental-strip-types scripts/moderation-hash.mjs",
    "eval:moderation": "pnpm --filter @songsmith/eval... build && pnpm --filter @songsmith/eval run eval moderation",
    "eval:lyricist": "pnpm --filter @songsmith/eval... build && pnpm --filter @songsmith/eval run eval lyricist",
    "eval:language": "node scripts/not-implemented.mjs eval:language T-46",
    "eval:golden": "pnpm --filter @songsmith/eval... build && pnpm --filter @songsmith/eval run golden && prettier --check eval",
    "openapi": "pnpm --filter @songsmith/schemas build && pnpm --filter @songsmith/i18n build && pnpm --filter @songsmith/backend openapi && pnpm --filter @songsmith/api-client generate && prettier --write backend/openapi.json packages/api-client/src/generated/schema.ts",
    "fixtures:audio": "pnpm --filter @songsmith/backend exec tsx scripts/fixtures-audio.ts",
    "build": "turbo run build",
    "check:exports": "node scripts/check-exports.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "redis:up": "docker compose -f docker/compose.yml up -d --wait",
    "redis:down": "docker compose -f docker/compose.yml down",
    "mobile:build:ios": "node --env-file-if-exists=.env.local scripts/mobile-build.mjs ios",
    "mobile:build:android": "node --env-file-if-exists=.env.local scripts/mobile-build.mjs android",
    "test:scripts": "vitest run --project @songsmith/scripts"
  },
  "prettier": "./packages/config/prettier.config.mjs",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supabase": "3.1.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
